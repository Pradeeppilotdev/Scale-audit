{
  "name": "@pradeeppilot/scale-audit",
  "version": "0.3.1",
  "description": "Static scale-readiness audit for public Node.js/TypeScript repos. Clones a repo (read-only) and reports what will break as traffic/users grow.",
  "keywords": [
    "scale",
    "performance",
    "static-analysis",
    "audit",
    "prisma",
    "n+1",
    "database",
    "pagination",
    "timeout",
    "concurrency",
    "nodejs",
    "typescript",
    "cli",
    "ci",
    "github-action",
    "code-review",
    "linter",
    "express",
    "nextjs"
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pradeeppilotdev/Scale-audit.git"
  },
  "bin": {
    "scale-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/cli.js",
    "serve": "node dist/server.js",
    "analyze": "tsx src/cli.ts",
    "test": "npm run build && node --test tests/*.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "glob": "^11.1.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "@types/node": "^22.9.0"
  }
}
